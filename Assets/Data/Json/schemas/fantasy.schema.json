{
    "$schema":  "https://json-schema.org/draft/2020-12/schema",
    "title":  "GoldfishWalking Fantasy",
    "type":  "object",
    "required":  [
                     "schemaVersion",
                     "id",
                     "rarity",
                     "effects"
                 ],
    "properties":  {
                       "schemaVersion":  {
                                             "const":  1
                                         },
                       "id":  {
                                  "type":  "string",
                                  "pattern":  "^[A-Za-z0-9_.-]+$"
                              },
                       "designerName":  {
                                            "type":  "string"
                                        },
                       "designerNote":  {
                                            "type":  "string"
                                        },
                       "enabled":  {
                                       "type":  "boolean"
                                   },
                       "sourceId":  {
                                        "type":  "integer"
                                    },
                       "localization":  {
                                            "type":  "object"
                                        },
                       "presentation":  {
                                            "type":  "object"
                                        },
                       "rarity":  {
                                      "enum":  [
                                                   "white",
                                                   "blue",
                                                   "red"
                                               ]
                                  },
                       "tags":  {
                                    "type":  "array",
                                    "items":  {
                                                  "type":  "string"
                                              }
                                },
                       "effects":  {
                                       "type":  "array",
                                       "items":  {
                                                     "type":  "object",
                                                     "required":  [
                                                                      "target",
                                                                      "operation"
                                                                  ]
                                                 }
                                   }
                   },
    "additionalProperties":  false
}
